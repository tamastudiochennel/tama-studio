# Copy to .env.local for local development. Never commit real values.
# Use a dedicated Firebase STAGING project until all launch checks pass.
FIREBASE_PROJECT_ID=your-firebase-staging-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_STAGING_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Netlify sets URL for deployed builds; set this locally only if needed.
URL=http://localhost:3000
